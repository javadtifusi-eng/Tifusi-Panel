# Copy this file to .env and set a real secret before deploying.
TIFUSI_SECRET_KEY=change-this-to-a-long-random-secret
TIFUSI_DATABASE_URL=sqlite+aiosqlite:///./data/tifusi.db

# Public URL clients can actually reach the panel at (used to build
# subscription links). Required once the panel runs behind Docker/a proxy —
# without it, subscription URLs are built from the request's Host header,
# which is an internal container hostname there, not something a client can use.
# This is also editable at runtime from the panel's own Settings page.
# TIFUSI_PUBLIC_URL=https://your-domain.example:8000

# Set both to run the panel with TLS terminated directly in uvicorn, for a
# deployment with no nginx/Caddy in front of it. Leave both unset (the
# default) to keep serving plain HTTP, same as before this existed.
# TIFUSI_SSL_CERTFILE=/app/certs/fullchain.pem
# TIFUSI_SSL_KEYFILE=/app/certs/privkey.pem

# Host-side ports docker-compose publishes the panel API and dashboard on —
# only needs changing if one of the defaults is already taken by something
# else on this server. install.sh asks and fills these in.
#
# TIFUSI_DASHBOARD_HTTPS_PORT defaults to 443 because that's what a browser
# assumes and what Let's Encrypt validates against — change it only when
# something in front expects a different one (Cloudflare's proxy reaches an
# origin on 443, 2053, 2083, 2087, 2096 or 8443 and nothing else). On any
# port but 443, set TIFUSI_PUBLIC_URL to match, including the port, or the
# subscription links handed to clients will point somewhere nothing listens.
#
# Port 80 is not configurable: the panel answers Let's Encrypt's HTTP-01
# challenge there (Settings > SSL Certificate > "Get free SSL").
# TIFUSI_PANEL_PORT=8000
# TIFUSI_DASHBOARD_PORT=8080
# TIFUSI_DASHBOARD_HTTPS_PORT=443

# Professional edition only (install.sh --pro writes these): the panel keeps
# its data in the bundled MySQL container instead of the SQLite file above.
# TIFUSI_EDITION=pro
# COMPOSE_FILE=docker-compose.yml:docker-compose.pro.yml
# TIFUSI_MYSQL_PASSWORD=<generated>
# TIFUSI_MYSQL_ROOT_PASSWORD=<generated>
# TIFUSI_DATABASE_URL=mysql+aiomysql://tifusi:<TIFUSI_MYSQL_PASSWORD>@mysql:3306/tifusi?charset=utf8mb4
