# Copy this file to .env and set a real secret before deploying.
TIFUSI_SECRET_KEY=change-this-to-a-long-random-secret
TIFUSI_DATABASE_URL=sqlite+aiosqlite:///./data/tifusi.db

# Public URL clients can actually reach the panel at (used to build
# subscription links). Required once the panel runs behind Docker/a proxy —
# without it, subscription URLs are built from the request's Host header,
# which is an internal container hostname there, not something a client can use.
# This is also editable at runtime from the panel's own Settings page.
# TIFUSI_PUBLIC_URL=https://your-domain.example:8000

# Set both to run the panel with TLS terminated directly in uvicorn, for a
# deployment with no nginx/Caddy in front of it. Leave both unset (the
# default) to keep serving plain HTTP, same as before this existed.
# TIFUSI_SSL_CERTFILE=/app/certs/fullchain.pem
# TIFUSI_SSL_KEYFILE=/app/certs/privkey.pem
